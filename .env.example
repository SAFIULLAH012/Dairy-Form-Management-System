# ============================================================
# Dairy Farm ERP — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values as needed.
# The app works 100% offline — most of these have sensible defaults.
# ============================================================

# Server port (default: 3001)
PORT=3001

# Node environment: development | production
NODE_ENV=development

# Absolute path to SQLite database file (optional override)
# Default: <project-root>/dairy_farm.sqlite
# DB_PATH=/custom/path/to/dairy_farm.sqlite

# Backup directory path (optional override)
# Default: <project-root>/backups/
# BACKUP_DIR=/custom/path/to/backups/

# Log level: error | warn | info | debug (default: info)
LOG_LEVEL=info
